---
import Layout from '../../layouts/Layout.astro';
import CardsGrid from '../../components/CardsGrid.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import CategoryFilter from '../../components/CategoryFilter.astro';
import { getArticles, articleUrl } from '../../lib/content';
import type { Section } from '../../content.config';
import { type Locale, t, sectionPath, sectionSlug } from '../../i18n';

const locale: Locale = 'ru';

export async function getStaticPaths() {
  // One page per RU section slug. EN equivalents live under /en/[section]/.
  return (['pereezd', 'zhizn', 'biznes', 'ai'] as const).map((section) => ({
    params: { section: section },
    props: { section },
  }));
}

const { section } = Astro.props as { section: Section };
const articles = (await getArticles(locale, section))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const cards = articles.map((a) => ({
  href: articleUrl(locale, section, a._meta.slug),
  title: a.data.title,
  description: a.data.description,
  eyebrow: a.data.reading_time ?? a.data.tags[0],
  cover: a.data.cover,
  // Carry the type/season/location through so the filter can use them.
  dataType: a.data.type,
  dataSeason: a.data.season,
  dataLocation: a.data.location,
}));

// Build distinct filter categories for the "Жизнь" section only.
const TYPE_LABELS_RU: Record<string, string> = {
  nature: 'Природа',
  gastro: 'Гастро',
  festival: 'Фестивали',
  family: 'С детьми',
  parade: 'Парады',
  market: 'Рынки',
  beach: 'Пляжи',
  other: 'Разное',
};
const distinctTypes = section === 'zhizn'
  ? Array.from(new Set(articles.map(a => a.data.type).filter((x): x is string => !!x))).sort()
  : [];
const typeCounts = (t: string) => articles.filter(a => a.data.type === t).length;
const chips = section === 'zhizn'
  ? [
      { value: '', label: 'Все', count: articles.length },
      ...distinctTypes.map(t => ({
        value: t,
        label: TYPE_LABELS_RU[t] ?? t,
        count: typeCounts(t),
      })),
    ]
  : [];

const titleKey = `section.${section}.title` as const;
const leadKey = `section.${section}.lead` as const;

// Per-section hero images. Sections without an entry fall back to the
// default sea photo baked into .hero-photo via --hero-image.
const HERO_IMAGES: Partial<Record<Section, string>> = {
  zhizn: '/photos/sections/zhizn-hero.jpg',
  biznes: '/photos/sections/biznes-hero.png',
};
const heroImage = HERO_IMAGES[section];
---
<Layout
  locale={locale}
  current={section}
  title={`${t(locale, titleKey)} ${t(locale, 'site.title.suffix')}`}
  description={t(locale, leadKey)}
  altUrl={`/en/${sectionSlug.en[section]}/`}
>
  <Breadcrumbs items={[
    { label: t(locale, 'nav.home'), href: sectionPath[locale].home },
    { label: t(locale, titleKey) },
  ]} />
  <div
    class="hero-photo hero-photo--compact"
    style={heroImage ? `--hero-image: url('${heroImage}')` : undefined}
  >
    <div class="hero-inner">
      <h1>{t(locale, titleKey)}</h1>
      <p class="lead">{t(locale, leadKey)}</p>
    </div>
  </div>
  {section === 'ai' && (
    <section class="section">
      <div class="section-inner">
        <div class="section-rule"></div>
        <h2 class="section-title" style="font-size: 28px;">Свежее видео</h2>
        <p class="section-sub">Скоро здесь будет встроенное YouTube-видео по AI для работы и жизни. Когда дашь ссылку — вставлю.</p>
        <div class="ai-video-placeholder">
          <span class="icon" aria-hidden="true"><svg><use href="#i-palette"/></svg></span>
          <span>Место под YouTube-embed</span>
        </div>
      </div>
    </section>
  )}

  <section class="section">
    <div class="section-inner">
      {section === 'ai' && (
        <>
          <div class="section-rule"></div>
          <h2 class="section-title" style="font-size: 28px;">Гиды и кейсы</h2>
        </>
      )}
      {section === 'zhizn' && chips.length > 0 && (
        <CategoryFilter chips={chips} label="Категории" />
      )}
      {cards.length === 0
        ? <p style="color: var(--ink-3); font-style: italic; font-family: var(--font-display); font-size: 18px;">Статьи этого раздела появятся в ближайшее время.</p>
        : <CardsGrid locale={locale} cards={cards} />}
    </div>
  </section>

  {section === 'ai' && (
    <section class="section section-alt">
      <div class="section-inner">
        <div class="section-rule"></div>
        <h2 class="section-title" style="font-size: 28px;">Наши продукты</h2>
        <p class="section-sub">То, что мы с мужем делаем параллельно: AI Studio под ключ для бизнесов и обучающее сообщество с курсами.</p>
        <div class="ai-products">
          <a class="ai-product" href="https://yesworkflow.com" target="_blank" rel="noopener">
            <span class="ai-eyebrow">AI Studio</span>
            <h3>YESWorkflow</h3>
            <p>AI-системы под ключ: голосовые боты, ассистенты для команд, кастомные интеграции. Кейсы — резервирование столиков, бухгалтерия, тендеры, аналитика.</p>
            <span class="ai-cta">yesworkflow.com →</span>
          </a>
          <a class="ai-product" href="https://www.aipack.live/courses" target="_blank" rel="noopener">
            <span class="ai-eyebrow">Курсы и сообщество</span>
            <h3>aipack.live</h3>
            <p>5 курсов: ChatGPT с нуля, n8n-автоматизации, Claude Code + вайбкодинг, Codex от OpenAI, дорожная карта «Твой путь» до первых клиентов.</p>
            <span class="ai-cta">Открыть курсы →</span>
          </a>
        </div>
      </div>
    </section>
  )}
</Layout>

<style>
  .ai-products {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 22px;
    margin-bottom: 16px;
  }
  .ai-product {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 32px 28px 28px;
    border-radius: 16px;
    background: #fff;
    border: 1px solid var(--line);
    color: var(--ink);
    text-decoration: none;
    transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
  }
  .ai-product:hover {
    transform: translateY(-4px);
    text-decoration: none;
    border-color: var(--coral);
    box-shadow: 0 12px 30px rgba(44,36,32,0.10);
  }
  .ai-eyebrow {
    font-size: 11.5px;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
    color: var(--coral);
  }
  .ai-product h3 {
    font-family: 'Fraunces', serif;
    font-size: 24px;
    font-weight: 700;
    margin: 0;
  }
  .ai-product p {
    color: var(--ink-2);
    font-size: 15px;
    line-height: 1.55;
    margin: 0;
  }
  .ai-cta {
    margin-top: 8px;
    color: var(--coral);
    font-size: 14px;
    font-weight: 700;
  }
  .ai-video-placeholder {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    aspect-ratio: 16/9;
    border: 2px dashed var(--line);
    border-radius: 16px;
    color: var(--ink-3);
    background: var(--paper-solid);
    font-family: var(--font-display);
    font-size: 20px;
    font-style: italic;
  }
  .ai-video-placeholder .icon { font-size: 28px; color: var(--coral); }
</style>
