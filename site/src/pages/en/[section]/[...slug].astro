---
import Layout from '../../../layouts/Layout.astro';
import { render } from 'astro:content';
import { getArticles, altArticleUrl } from '../../../lib/content';
import { type Locale, t, sectionPath, sectionSlug } from '../../../i18n';

export async function getStaticPaths() {
  // getStaticPaths runs in isolation — inline the locale literal.
  const articles = await getArticles('en');
  return articles.map((entry) => ({
    // section param uses the EN URL slug; ...slug stays as-is.
    params: { section: sectionSlug.en[entry._meta.section], slug: entry._meta.slug },
    props: { entry },
  }));
}

const locale: Locale = 'en';

const { entry } = Astro.props;
const { Content } = await render(entry);
const formatted = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }).format(entry.data.date);

const all = await getArticles('ru');
const altUrl = altArticleUrl(all, 'ru', entry._meta.section, entry._meta.slug);

const sectionTitleKey = `section.${entry._meta.section}.title` as const;
---
<Layout
  locale={locale}
  current={entry._meta.section}
  title={`${entry.data.title} ${t(locale, 'site.title.suffix')}`}
  description={entry.data.description}
  ogImage={entry.data.cover ?? '/og-default.jpg'}
  altUrl={altUrl}
>
  <article class="section">
    <div class="prose">
      <p style="color: var(--coral); font-size: 13px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase;">
        {t(locale, sectionTitleKey)}
        {entry.data.reading_time && ` · ${entry.data.reading_time}`}
      </p>
      <h1>{entry.data.title}</h1>
      <p style="color: var(--ink-2); font-size: 14px; margin-bottom: 28px;">{formatted}</p>
      {entry.data.cover && <img src={entry.data.cover} alt={entry.data.title} />}
      <Content />
      <p style="margin-top: 48px;">
        <a class="btn btn-ghost" href={sectionPath[locale][entry._meta.section]}>{t(locale, 'section.back')}</a>
      </p>
    </div>
  </article>
</Layout>
