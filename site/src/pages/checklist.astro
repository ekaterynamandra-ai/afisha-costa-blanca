---
import Layout from '../layouts/Layout.astro';
import { type Locale } from '../i18n';

const locale: Locale = 'ru';

// Paid product. Until Gumroad is live, /spain/ is the single buy-landing —
// it owns the checkout link so this page never needs touching again.
const PRICE = '€49';
const BUY_URL = '/spain/';

// The eight sections of the paid checklist. Shown as an overview grid first,
// then again below as an accordion with the step titles inside each.
const sections = [
  {
    num: '01',
    name: 'Документы',
    lead: 'NIE, empadronamiento, TIE, цифровой сертификат',
    steps: [
      'Получить NIE: куда идти, что взять, что говорить',
      'Empadronamiento: certificado, а не volante — и почему это важно',
      'TIE: когда подавать и как не пропустить срок',
      'Цифровой сертификат (Cl@ve / FNMT) — первый шаг после NIE',
      'Апостиль и присяжный перевод: что реально нужно',
      'Продление статуса: за сколько ставить напоминание',
    ],
    extras: ['2 шаблона писем в extranjería', 'Скриншот формы EX-15 с подсказками'],
  },
  {
    num: '02',
    name: 'Жильё',
    lead: 'Аренда, договор, депозит, счётчики',
    steps: [
      'Contrato de arrendamiento: что читать перед подписью',
      'Депозит и fianza — как потом вернуть',
      'Фотофиксация при заезде: что снимать',
      'Cambio de titular счётчиков',
      'Красные флаги в объявлении и на просмотре',
    ],
    extras: ['Шаблон письма арендодателю', 'Чек-лист осмотра квартиры'],
  },
  {
    num: '03',
    name: 'Банки',
    lead: 'Счёт, IBAN, автосписания, переводы',
    steps: [
      'Открыть счёт: что взять с собой',
      'IBAN и domiciliación — без этого не работает ничего',
      'Настроить автосписание аренды и коммуналки',
      'Переводы из своей страны: лимиты и блокировки',
    ],
    extras: ['Скрипт разговора в отделении на испанском'],
  },
  {
    num: '04',
    name: 'Медицина',
    lead: 'SIP, врач de familia, страховка',
    steps: [
      'Прикрепиться к centro de salud',
      'Получить SIP-карту',
      'Выбрать врача de familia',
      'Что делать, пока карточки ещё нет',
      'Дежурная аптека (farmacia de guardia)',
    ],
    extras: ['Скрипт записи к врачу', 'Что говорить, если «мест нет»'],
  },
  {
    num: '05',
    name: 'Налоги и деньги',
    lead: 'Резидент или нет, что это меняет',
    steps: [
      'Налоговый статус: резидент vs нерезидент',
      'Что это меняет в первый год',
      'Когда точно нужен gestor, а когда нет',
    ],
    extras: ['Мой расчёт по первому году'],
  },
  {
    num: '06',
    name: 'Транспорт',
    lead: 'Машина, растаможка, ITV, права',
    steps: [
      'Нужна ли вообще машина — честный ответ',
      'Растаможка и постановка на учёт',
      'ITV: когда, где, сколько',
      'Автошкола и экзамен',
      'Обмен прав в DGT',
    ],
    extras: ['Мой таймлайн: даты, шаги и суммы'],
  },
  {
    num: '07',
    name: 'Быт',
    lead: 'Свет, вода, интернет, мусор',
    steps: [
      'Как читать счёт за свет и за что ты платишь',
      'Тарифы по времени суток: где реально экономятся деньги',
      'Интернет и мобильный: что подключать',
      'Вода, мусор, comunidad de propietarios',
    ],
    extras: ['Шаблоны писем провайдерам', 'Разбор моего реального счёта'],
  },
  {
    num: '08',
    name: 'Животные',
    lead: 'Ветеринар, страховка, реальные суммы',
    steps: [
      'Сколько на самом деле стоит визит к ветеринару',
      'Страховка для животного: почему она не работает сразу',
      'Почему в первые месяцы животные болеют чаще',
      'Когда страховка окупается, а когда нет',
    ],
    extras: ['Мой расчёт: во что обошёлся первый год с животным'],
  },
  {
    num: '09',
    name: 'Язык и жизнь',
    lead: 'Испанский, ритм страны, соседи',
    steps: [
      '5 способов начать испанский — и что работает',
      'Бесплатные курсы в ayuntamiento: как попасть',
      'Ритм страны: сиеста, время еды, когда всё закрыто',
      'Соседи и comunidad — как не начать с конфликта',
    ],
    extras: ['Список бесплатных курсов', 'Мои 3 ошибки в общении'],
  },
];

// What every one of the ~60 steps answers.
const anatomy = [
  'Куда идти',
  'Что взять с собой',
  'Что говорить (фраза на испанском)',
  'Сколько это должно стоить',
  'Что можно сделать самостоятельно',
];

const emergency = [
  { num: '112', label: 'Главный номер ЕС',     hint: 'Полиция, скорая, пожарные — один звонок. Бесплатно, работает без SIM.' },
  { num: '061', label: 'Скорая помощь',        hint: 'Медицинская экстренная служба. Для ДТП лучше 112 — диспетчер пришлёт сразу всех нужных.' },
  { num: '091', label: 'Национальная полиция', hint: 'Policía Nacional. Документы, серьёзные преступления, пропажа паспорта, иммиграция.' },
  { num: '062', label: 'Гражданская гвардия',  hint: 'Guardia Civil. Вне городов, на шоссе, пограничные вопросы, спасение в горах и на море.' },
  { num: '092', label: 'Местная полиция',      hint: 'Policía Local. Парковка, шум, местные ЧП, бытовые конфликты в своём городе.' },
  { num: '080', label: 'Пожарные',             hint: 'Bomberos. Пожары, спасение животных, затопления, ДТП с застрявшими.' },
  { num: '016', label: 'Помощь женщинам',      hint: 'Круглосуточная линия по домашнему и гендерному насилию. Звонок не отражается в списке вызовов.' },
  { num: '024', label: 'Кризис и суицид',      hint: 'Психологическая поддержка в острых ситуациях. Бесплатно, 24/7, анонимно.' },
];

const bundled = [
  'PDF — 9 разделов, около 60 шагов',
  'Google Sheet с чекбоксами: отмечаешь, что уже сделано',
  '10 шаблонов писем на испанском',
  'Скриншоты форм с подсказками, где что писать',
  'Календарь: что за чем делать, чтобы не ходить дважды',
  'Post-mortem: 10 моих ошибок и сколько они стоили',
];

// Free, already-built asset — used as a bonus inside the paid bundle.
const CALC_URL = '#';

// The pain block. Every line is a real number, and every one of them is
// "I didn't know you could do it that way" — not "it was too hard".
// One line each. The "why" lives in the sections above — repeating it here
// turned this block into a wall of text.
const pains = [
  { price: '−€100', text: 'Помогатору за прописку — за поход в мэрию с твоим же паспортом' },
  { price: '−€500', text: 'Помогатору за NIE. И отдельно за TIE. Умножь на всю семью' },
  { price: '−€100–200', text: 'Переплата за свет, каждый месяц: не тот тариф, не тот провайдер' },
  { price: '−€200', text: 'Штраф за просроченный ITV' },
  { price: '−€50', text: 'Каждый визит к ветеринару, пока животное адаптируется' },
  { price: '− дни', text: 'Поездки впустую: без cita, без нужной бумажки, на ресепшн вместо приложения' },
];

// Questions in the buyer's head before they pay — not the ones convenient to answer.
const faq = [
  {
    q: 'Что именно я получу за €49?',
    a: 'Технически: PDF на 9 разделов и около 60 шагов, Google Sheet с чекбоксами, 10 шаблонов писем на испанском, скриншоты форм с подсказками. По сути — мой личный опыт: ошибки, за которые я заплатила, пробы, вопросы, которые я годами разбирала по кускам, выспрашивала у местных и у своих. Всё, что я собрала, чтобы здесь нормально адаптироваться, — в одном месте и уже проверенное на себе.',
  },
  {
    q: 'А разве это не то, что и так можно бесплатно найти в интернете?',
    a: 'Попробуй. Задай свой вопрос в пяти чатах и посмотри, кто и что ответит — и можно ли на это положиться. Правду от чужой догадки ты отличишь только временем: своим, потраченным на лишний визит, просроченный срок или ненужную услугу. У меня этот путь уже пройден, и он здесь разложен по шагам.',
  },
  {
    q: 'Я только планирую переезжать — мне подойдёт?',
    a: 'Да, и это лучший момент. Половина ошибок первого года закладывается до приезда: не тот документ не апостилирован, бумаги поданы не в том порядке, что-то надо было сделать ещё дома. Чек-лист как раз показывает порядок.',
  },
  {
    q: 'Смогу спросить у тебя по своему случаю — с документами, с миграционным статусом?',
    a: 'Нет, и я скажу честно почему: я не юрист и не гестор, консультаций не даю и не хочу отвечать за чужой статус. В чек-листе — мой личный опыт: что делала я, что не сработало и что бы сделала иначе. Юридические тонкости твоего случая — к юристу.',
  },
];
---

<Layout
  locale={locale}
  current="pereezd"
  title="Пошаговый чек-лист для первого года в Испании · Kate in Spain"
  description="Как адаптироваться в Испании самостоятельно и не переплачивать посредникам. 8 разделов, около 60 шагов. Один шаг открыт бесплатно целиком."
>
  <!-- ===== HERO ===== -->
  <section class="hero-photo hero-checklist">
    <div class="hero-inner">
      <span class="eyebrow">Испания без «помогаторов»</span>
      <h1>Пошаговый чек-лист</h1>
      <p class="hero-sub">
        Как адаптироваться в Испании самостоятельно и не переплачивать посредникам
      </p>

      <div class="stats">
        <div class="stat"><span class="stat-num">9</span><span class="stat-cap">разделов</span></div>
        <div class="stat"><span class="stat-num">~60</span><span class="stat-cap">шагов</span></div>
        <div class="stat"><span class="stat-num">10</span><span class="stat-cap">шаблонов писем</span></div>
        <div class="stat"><span class="stat-num">5 лет</span><span class="stat-cap">личного опыта</span></div>
      </div>

      <div class="hero-actions">
        <a class="btn btn-primary" href={BUY_URL}>Получить чек-лист за {PRICE}</a>
      </div>
      <p class="hero-alt">
        <a href="#primer">Посмотреть один шаг бесплатно →</a>
      </p>
    </div>
  </section>

  <!-- ===== WHAT'S INSIDE — 8 SECTIONS ===== -->
  <section class="section reveal">
    <div class="section-inner narrow">
      <span class="kicker">Содержание</span>
      <h2 class="section-title">Что внутри</h2>
      <p class="section-sub">
        Девять разделов — всё, с чем сталкиваешься после переезда.
      </p>

      <ul class="topics">
        {sections.map((s) => (
          <li class="topic">
            <span class="topic-num">{s.num}</span>
            <span class="topic-name">{s.name}</span>
            <span class="topic-lead">{s.lead}</span>
          </li>
        ))}
      </ul>

      <p class="anatomy">
        <b>В каждом шаге:</b> куда идти · что взять с собой · что говорить по-испански ·
        сколько это должно стоить · что можно сделать самостоятельно.
      </p>

      <div class="offer">
        <div class="offer-text">
          <h3>Один платёж — доступ навсегда</h3>
          <p>
            Купи сейчас за {PRICE} и получай все будущие разделы и обновления бесплатно.
            По мере наполнения чек-листа цена будет расти.
          </p>
        </div>
        <a class="btn btn-primary" href={BUY_URL}>Получить чек-лист за {PRICE}</a>
      </div>
    </div>
  </section>

  <!-- ===== FREE SAMPLE STEP ===== -->
  <section class="section section-alt reveal" id="primer">
    <div class="section-inner narrow">
      <span class="kicker">Бесплатный пример</span>
      <h2 class="section-title">Один шаг — бесплатно и целиком</h2>
      <p class="section-sub">
        Так выглядит каждый из ~60 шагов. Это не оглавление — это то, что ты берёшь и делаешь.
      </p>

      <article class="sample">
        <header class="sample-head">
          <span class="sample-kicker">Раздел 01 · Документы — шаг 2</span>
          <h3>Empadronamiento (прописка)</h3>
          <div class="sample-price">
            <span class="price-col">
              <span class="price-cap">Помогатор берёт</span>
              <span class="price-val">€60–120</span>
            </span>
            <span class="price-col price-col--free">
              <span class="price-cap">Реальная цена</span>
              <span class="price-val">0 €</span>
            </span>
          </div>
        </header>

        <div class="sample-block">
          <span class="sample-label">Куда идти и как записаться</span>
          <p>
            Отдел <b>Padrón</b> в ayuntamiento твоего города. Единого портала нет — у каждого
            города свой, ищи «padrón + [твой город]».
          </p>
          <ul class="sample-list">
            <li><b>Онлайн, если есть цифровой сертификат или Cl@ve</b> — самый быстрый путь: подаёшь через sede electrónica города, справка приходит сразу</li>
            <li><b>Лично</b> — через cita previa на сайте. Ждать приёма можно неделями, особенно в сезон</li>
            <li><b>Торревьеха, 2026</b> — cita previa на padrón отменили, всё только через sede electrónica. Проверь, не поменялось ли так же в твоём городе</li>
          </ul>
        </div>

        <div class="sample-block">
          <span class="sample-label">Что взять с собой</span>
          <ul class="sample-list">
            <li><b>Паспорт</b> — оригинал <i>и</i> копия. Копию на месте не сделают</li>
            <li><b>Договор аренды на твоё имя</b> — подписанный обеими сторонами</li>
            <li><b>Заявление (hoja padronal)</b> — скачай с сайта и заполни дома</li>
            <li>
              <b>Если живёшь у кого-то, а не по своему договору</b> — нужна autorización от
              собственника или арендатора: он письменно разрешает тебе прописаться. Плюс копия
              его DNI/NIE и документ на жильё (эскритура, договор или счёт за воду). Шаблон ниже
            </li>
          </ul>
        </div>

        <div class="sample-block">
          <span class="sample-label">Что говорить</span>
          <blockquote class="es">
            <p class="es-line">Hola, buenos días. Vengo a empadronarme. Traigo el pasaporte y el contrato de alquiler.</p>
            <p class="es-tr">Здравствуйте. Я пришёл(ла) оформить прописку. У меня с собой паспорт и договор аренды.</p>
          </blockquote>
          <blockquote class="es">
            <p class="es-line">¿Me puede dar el certificado de empadronamiento, por favor?</p>
            <p class="es-tr">Дайте, пожалуйста, certificado — он нужен мне для SIP.</p>
          </blockquote>
          <p class="sample-warn">
            Проси именно <b>certificado</b>, а не <b>volante</b>. Volante — короткая справка, её не
            примут для TIE и школы, и придётся идти второй раз.
          </p>
        </div>

        <div class="sample-block">
          <span class="sample-label">Язык: не рассчитывай на английский</span>
          <p>
            В мэрии по-английски чаще всего <b>не говорят</b> — это факт, а не придирка. Мобильный
            переводчик тоже принимают не везде: в Торревьехе, например, могут просто попросить
            прийти с человеком. <b>Если не говоришь по-испански — бери с собой того, кто переведёт.</b>
            Это дешевле, чем гестор, и надёжнее, чем надежда на доброго сотрудника.
          </p>
        </div>

        <div class="sample-block">
          <span class="sample-label">У справки есть срок годности</span>
          <p>
            Сам факт прописки бессрочный, но <b>certificado почти везде принимают только «свежий» —
            не старше 3 месяцев</b>. Не заказывай его заранее «чтобы был»: бери под конкретную
            подачу — на SIP, на TIE, в школу. Иначе к нужному дню он протухнет и придётся брать
            заново.
          </p>
        </div>

        <div class="sample-mistake">
          <span class="sample-label">Главная ошибка, которая стоит недель</span>
          <p>
            Прийти без нужной копии или не с тем документом. Тебя не «доофрмят потом» — тебя
            развернут и отправят брать <b>новую cita</b>. А следующее окно может быть не через
            день-два, а через недели. Поэтому список документов проверяют <i>до</i> выхода из дома,
            а не в очереди.
          </p>
        </div>

        <div class="sample-template">
          <span class="sample-label">Шаблон: autorización от хозяина жилья</span>
          <pre>D./Dña. [ИМЯ СОБСТВЕННИКА], con DNI/NIE [НОМЕР], propietario/a de
la vivienda situada en [АДРЕС],

AUTORIZO

a D./Dña. [ТВОЁ ИМЯ], con pasaporte/NIE [НОМЕР], a empadronarse
en dicho domicilio.

En [ГОРОД], a [ДАТА].

Firma del propietario/a:</pre>
          <p class="template-note">
            Нужна только если ты прописываешься там, где не являешься собственником или
            арендатором по договору — например, живёшь у знакомых. К ней прикладываешь копию
            его DNI/NIE и документ на жильё.
          </p>
        </div>
      </article>

      <p class="sample-after">
        Таких шагов — около шестидесяти. <a href={BUY_URL}>Забрать все за {PRICE} →</a>
      </p>
    </div>
  </section>

  <!-- ===== ALL SECTIONS, STEP BY STEP ===== -->
  <section class="section reveal">
    <div class="section-inner narrow">
      <span class="kicker">Подробно</span>
      <h2 class="section-title">Все шаги по разделам</h2>
      <p class="section-sub">Раскрой любой раздел — видно, из чего он состоит и что к нему прилагается.</p>

      <div class="locked-list">
        {sections.map((s) => (
          <details class="locked">
            <summary>
              <span class="locked-meta">
                <span class="locked-kicker">{s.num}</span>
                <span class="locked-name">{s.name}</span>
              </span>
              <span class="locked-count">{s.steps.length} шагов</span>
              <span class="locked-chevron" aria-hidden="true">
                <svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2"
                     stroke-linecap="round" stroke-linejoin="round"><path d="M5 8l5 5 5-5"/></svg>
              </span>
            </summary>
            <div class="locked-body">
              <ul class="locked-steps">
                {s.steps.map((step) => <li>{step}</li>)}
              </ul>
              <div class="locked-extras">
                <span class="locked-extras-title">Что прилагается</span>
                <ul>
                  {s.extras.map((x) => <li>{x}</li>)}
                </ul>
              </div>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>

  <!-- ===== PAIN ===== -->
  <section class="section section-alt reveal">
    <div class="section-inner narrow">
      <span class="kicker">Цена незнания</span>
      <h2 class="section-title">Сколько стоит не разбираться самостоятельно</h2>
      <p class="section-sub">
        Куда ни плюнь — везде нужна <b>cita</b>. В мэрию, в банк, к врачу, в extranjería.
