<script>
  // Cost of not knowing the system, per year. Every rate is a number Kate can defend:
  // per person — gestor for empadronamiento (100) + NIE/TIE (500);
  // per household — electricity overpayment on the wrong tariff;
  // per car — a missed ITV fine; per pet — vet visits before insurance kicks in.
  const RATE = {
    docsPerPerson: 600,
    lightPerHousehold: 600,
    finePerCar: 200,
    vetPerPet: 300,
  };

  const state = { people: 1, cars: 0, pets: 0 };
  const LIMIT = { people: [1, 8], cars: [0, 4], pets: [0, 6] };

  // Sticky buy bar + back-to-top: both appear once the hero is scrolled past.
  const bar = document.getElementById('sticky-buy');
  const top = document.getElementById('to-top');
  const hero = document.querySelector('.hero-checklist');
  if (hero) {
    const io = new IntersectionObserver(
      ([entry]) => {
        if (bar) bar.hidden = entry.isIntersecting;
        if (top) top.hidden = entry.isIntersecting;
      },
      { threshold: 0 },
    );
    io.observe(hero);
  }
  top?.addEventListener('click', () => {
    window.scrollTo({ top: 0, behavior: 'smooth' });
  });

  // The whole grid fades up once, as a single object.
  const grid = document.querySelector<HTMLElement>('.topics');
  if (grid) {
    const gridIo = new IntersectionObserver(
      ([e]) => {
        if (!e.isIntersecting) return;
        grid.classList.add('in');
        gridIo.disconnect();
      },
      { threshold: 0.1, rootMargin: '0px 0px -60px' },
    );
    gridIo.observe(grid);
  }

  const calc = document.getElementById('calc');
  if (calc) {
    const euro = (n: number) => '€' + n.toLocaleString('ru-RU').replace(/,/g, ' ');
    const breakdownEl = document.getElementById('calc-breakdown')!;
    const totalEl = document.getElementById('calc-total')!;

    const render = () => {
      // Labels only — the "why" is already spelled out in the ledger above.
      const lines = [
        { label: `Документы · ${state.people} чел.`, sum: RATE.docsPerPerson * state.people },
        { label: 'Свет за год', sum: RATE.lightPerHousehold },
      ];
      if (state.cars > 0) {
        lines.push({ label: `ITV · ${state.cars} авто`, sum: RATE.finePerCar * state.cars });
      }
      if (state.pets > 0) {
        lines.push({ label: `Ветеринар · ${state.pets}`, sum: RATE.vetPerPet * state.pets });
      }

      const total = lines.reduce((acc, l) => acc + l.sum, 0);

      breakdownEl.innerHTML = lines
        .map(
          (l) => `<li><span class="bd-label">${l.label}</span><span class="bd-sum">−${euro(l.sum)}</span></li>`,
        )
        .join('');

      totalEl.textContent = '−' + euro(total);
      (document.getElementById('out-people') as HTMLElement).textContent = String(state.people);
      (document.getElementById('out-cars') as HTMLElement).textContent = String(state.cars);
      (document.getElementById('out-pets') as HTMLElement).textContent = String(state.pets);
    };

    calc.querySelectorAll<HTMLButtonElement>('button[data-step]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const key = btn.dataset.step as keyof typeof state;
        const [min, max] = LIMIT[key];
        const next = state[key] + Number(btn.dataset.dir);
        state[key] = Math.min(max, Math.max(min, next));
        render();
      });
    });

    render();
  }
</script>

