---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import IconSprite from '../components/IconSprite.astro';
import { type Locale, type NavCurrent, t, altLocale, sectionPath } from '../i18n';

interface Props {
  locale: Locale;
  current: NavCurrent;
  title?: string;
  description?: string;
  ogImage?: string;
  altUrl?: string;
  /** Set on article pages so Open Graph and JSON-LD describe an article, not the site. */
  article?: { published?: Date; modified?: Date; section?: string };
}

const {
  locale,
  current,
  title,
  description,
  ogImage = '/og-default.jpg',
  altUrl,
  article,
} = Astro.props;

const pageTitle = title ?? t(locale, 'site.title.default');
const pageDesc = description ?? t(locale, 'site.desc.default');
const canonical = new URL(Astro.url.pathname, Astro.site).toString();
const htmlLang = locale === 'ru' ? 'ru' : 'en';
const other = altLocale(locale);
const hrefOther = altUrl ?? sectionPath[other].home;
const ogImageUrl = new URL(ogImage, Astro.site).toString();

const AUTHOR = 'Kate in Spain';

// Structured data: an article page describes itself as a BlogPosting; every
// other page just identifies the site.
const jsonLd = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: pageTitle,
      description: pageDesc,
      image: ogImageUrl,
      url: canonical,
      inLanguage: htmlLang,
      datePublished: article.published?.toISOString(),
      dateModified: (article.modified ?? article.published)?.toISOString(),
      articleSection: article.section,
      author: { '@type': 'Person', name: AUTHOR, url: Astro.site?.toString() },
      publisher: { '@type': 'Organization', name: AUTHOR, url: Astro.site?.toString() },
      mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: AUTHOR,
      url: Astro.site?.toString(),
      inLanguage: htmlLang,
      publisher: { '@type': 'Organization', name: AUTHOR, url: Astro.site?.toString() },
    };
---
<!DOCTYPE html>
<html lang={htmlLang}>
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{pageTitle}</title>
  <meta name="description" content={pageDesc} />
  <link rel="canonical" href={canonical} />
  <link rel="alternate" hreflang={htmlLang} href={canonical} />
  <link rel="alternate" hreflang={other === 'ru' ? 'ru' : 'en'} href={new URL(hrefOther, Astro.site).toString()} />
  <link rel="alternate" hreflang="x-default" href={Astro.site?.toString() ?? '/'} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- Fonts: Playfair Display (display, Cyrillic-safe) + Inter (body) -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,600;1,500;1,600&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />

  <!-- Open Graph -->
  <meta property="og:title" content={pageTitle} />
  <meta property="og:description" content={pageDesc} />
  <meta property="og:type" content={article ? 'article' : 'website'} />
  <meta property="og:url" content={canonical} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:site_name" content={AUTHOR} />
  <meta property="og:locale" content={locale === 'ru' ? 'ru_RU' : 'en_US'} />
  {article?.published && (
    <meta property="article:published_time" content={article.published.toISOString()} />
  )}

  <!-- Twitter -->
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={pageTitle} />
  <meta name="twitter:description" content={pageDesc} />
  <meta name="twitter:image" content={ogImageUrl} />

  <meta name="generator" content={Astro.generator} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

  <script is:inline>document.documentElement.classList.add('js');</script>

  <!-- GoatCounter analytics (cookieless, EU-hosted) -->
  <script data-goatcounter="https://kateinspain.goatcounter.com/count"
          async src="//gc.zgo.at/count.js"></script>
</head>
<body>
  <IconSprite />
  <Nav locale={locale} current={current} altUrl={altUrl} />
  <main>
    <slot />
  </main>
  <Footer locale={locale} />

  <script>
    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) {
          e.target.classList.add('visible');
          io.unobserve(e.target);
        }
      }
    }, { threshold: 0.12, rootMargin: '0px 0px -40px' });
    document.querySelectorAll('.reveal').forEach((el) => io.observe(el));
  </script>
</body>
</html>
