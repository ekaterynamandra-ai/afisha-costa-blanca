---
import { TG_URL, TG_HANDLE } from '../config';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;

const text = locale === 'ru'
  ? 'Каждый день пишу про жизнь на Коста-Бланке в Telegram'
  : 'Daily notes on life on Costa Blanca in Telegram';
const cta = locale === 'ru' ? 'Подписаться' : 'Subscribe';
---
<aside class="tg-cta reveal">
  <span class="tg-cta-eyebrow">Telegram</span>
  <p class="tg-cta-text">{text}</p>
  <p class="tg-cta-handle">@{TG_HANDLE}</p>
  <a class="tg-cta-btn" href={TG_URL} target="_blank" rel="noopener">{cta} →</a>
</aside>

<style>
  .tg-cta {
    margin: 56px 0 0;
    padding: 32px clamp(20px, 4vw, 40px);
    background: var(--bg-alt, #F4EADA);
    border: 1px solid var(--line, #E8DFD3);
    border-radius: 16px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    gap: 8px;
  }
  .tg-cta-eyebrow {
    font-family: var(--font-eyebrow, 'Inter', sans-serif);
    font-size: var(--text-eyebrow, 12px);
    font-weight: 600;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--coral, #C25E3C);
    margin-bottom: 6px;
  }
  .tg-cta-text {
    margin: 0;
    color: var(--ink, #2C2420);
    font-family: var(--font-display, 'Playfair Display', serif);
    font-size: clamp(18px, 2vw, 22px);
    font-weight: 500;
    line-height: 1.3;
    max-width: 32ch;
  }
  .tg-cta-handle {
    margin: 0 0 12px;
    font-family: var(--font-body, 'Inter', sans-serif);
    font-size: 14px;
    color: var(--ink-2, #5C544E);
    letter-spacing: 0.02em;
  }
  .tg-cta-btn {
    display: inline-block;
    padding: 12px 24px;
    background: var(--coral, #C25E3C);
    color: #fff;
    text-decoration: none;
    border-radius: 10px;
    font-family: var(--font-body, 'Inter', sans-serif);
    font-weight: 600;
    font-size: 14px;
    letter-spacing: 0.02em;
    white-space: nowrap;
    transition: background 0.18s ease, transform 0.18s ease;
  }
  .tg-cta-btn:hover {
    background: var(--coral-deep, #A84A2E);
    text-decoration: none;
    transform: translateY(-1px);
  }
</style>
